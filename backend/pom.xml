<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 🔴 2026-10-18 框架升级方案 A:
             3.2 早已停维护,3.5.16 是 3.5 的最后一个免费版(3.5 也已于 2026-06-30 停免费维护,
             Boot 4 排在 2027-03 前单独做)。带 Spring 6.2.19 / Security 6.5.11 / Logback 1.5.34。 -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.group.scm</groupId>
    <artifactId>scm-backend</artifactId>
    <version>1.0.0</version>
    <name>scm-backend</name>
    <description>集团进销存协同平台 · 后端</description>

    <properties>
        <java.version>17</java.version>
        <!-- 部署脚本用 -Dgit.sha=xxx 覆盖;本地构建保持 unknown -->
        <git.sha>unknown</git.sha>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.10</mybatis-plus.version>
        <sa-token.version>1.38.0</sa-token.version>
        <knife4j.version>4.4.0</knife4j.version>
        <fastjson.version>2.0.43</fastjson.version>
        <hutool.version>5.8.25</hutool.version>
        <!-- 覆盖 Spring Boot 默认 Lombok(1.18.32)。本机 Maven 默认 JDK 较新(26)，
             旧版 Lombok 注解处理器会因 javac 内部 API 变化崩溃，故升级到兼容新 JDK 的版本。
             仅影响编译期代码生成，运行 jar 不含 Lombok，对部署产物无影响；目标字节码仍为 Java 17。 -->
        <lombok.version>1.18.46</lombok.version>
        <!-- 🔴 2026-10-18(安全审查 S01):Spring Boot 3.2.5 自带的 Tomcat 10.1.20 有 multipart 内存耗尽漏洞
             (CVE-2025-48988 / CVE-2025-48976,10.1.42 起修复),解析发生在登录拦截之前,未登录就能打。
             只覆盖 Tomcat 版本、不整体升级 Spring Boot,影响面最小;10.1.x 小版本之间接口兼容。
             新版默认每个上传请求最多 10 个部件(maxPartCount),本系统附件一次一个文件,不受影响。 -->
        <tomcat.version>10.1.60</tomcat.version>
        <!-- 2026-10-18 方案 A:Boot 3.5.16 自带的这几个版本仍有公开漏洞记录,覆盖到修复版(均发布满两周)。
             jackson 2.21.4→2.21.7(每个接口的 JSON 解析入口);commons-lang3 3.17.0→3.20.0;log4j2 2.24.3→2.25.5。 -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <dependencies>
        <!-- web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- mysql -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- mybatis-plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- sa-token: 鉴权 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- 密码加密 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- knife4j: API 文档 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>

        <!-- 工具 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <!-- 2026-10-18(安全审查 S07):5.2.5 有 CVE-2025-31672(同名 ZIP 条目让不同工具读到不同内容),5.4.0 起修复 -->
            <version>5.4.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>scm-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 显式声明 Lombok 注解处理器路径，保证在 JDK 21 下稳定运行 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!--
                      发布可追溯:把版本号、构建时间、Git 提交号
                      打进 jar 的 META-INF/build-info.properties,登录后可在 /system/version 查。
                      出事时能一眼确认「线上跑的到底是哪次提交」,不用靠记忆或猜。
                      git.sha 由部署脚本传入(-Dgit.sha=xxx);本地直接 mvn 时是 unknown,不报错。
                    -->
                    <execution>
                        <id>build-info</id>
                        <goals><goal>build-info</goal></goals>
                        <configuration>
                            <additionalProperties>
                                <git.sha>${git.sha}</git.sha>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
