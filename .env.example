# 复制成 .env 再改:  cp .env.example .env
# ⚠️ .env 里是密码,不要提交到 Git(.gitignore 已排除)

# 数据库密码(必填,改成你自己的长密码)
DB_ROOT_PASSWORD=
DB_PASSWORD=

# 管理员 admin 的初始密码(选填;留空则首次启动随机生成,用 docker compose logs backend | grep 初始密码 查看)
ADMIN_PASSWORD=
# 演示账号 demo 的初始密码(选填;留空同上随机生成)
DEMO_PASSWORD=

# 浏览器访问端口
WEB_PORT=8080
# 前面配了 HTTPS 时改成 true,登录凭证只走加密连接
COOKIE_SECURE=false
